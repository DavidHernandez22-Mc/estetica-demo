{
  // Static site: `npm run build` writes the Next.js static export to ./out and Cloudflare
  // serves it as assets. worker/index.mjs only redirects workers.dev to the custom domain.
  "name": "estetica-demo",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.mjs",
  "workers_dev": true,
  // Dominio propio; la dirección de workers.dev redirige con 301 (worker/index.mjs).
  "routes": [{ "pattern": "estetica.davidhcwebs.com", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Todo pasa por worker/index.mjs para redirigir workers.dev al dominio propio.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
